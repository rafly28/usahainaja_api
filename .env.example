# Copy this file to .env and replace the DATABASE_URL for your local PostgreSQL.
ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/usahainaja?sslmode=disable
COOKIE_NAME=usahainaja_session
COOKIE_SECURE=false
SESSION_TTL=168h
BCRYPT_COST=12
SHUTDOWN_TIMEOUT=10s
